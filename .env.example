# =============================================================================
# Agente de Chat Affiore — configuração
# Copie para .env e preencha. NUNCA versione o .env (já está no .gitignore).
# =============================================================================

# --- Provedor de LLM ---------------------------------------------------------
# Configure ao menos UMA chave. O agente tenta os provedores na ordem abaixo e
# avança para o próximo quando o anterior falha (quota, 429, timeout).
# Ordem: gemini -> groq -> openrouter

# Qual provedor deve ser tentado primeiro.
# Valores: gemini (padrao) | groq | openrouter
LLM_PRIMARY_PROVIDER=gemini

# Desliga o tool-calling em todos os provedores.
# Útil quando o modelo não respeita o schema da tool.
LLM_DISABLE_TOOLS=false

# Chave do Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Chave da Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Chave do OpenRouter (alternativa gratuita) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- API HTTP ----------------------------------------------------------------

# Token exigido em Authorization: Bearer <token> (ou X-API-Key).
# VAZIO = API aberta. Defina antes de expor o serviço: todo /chat custa tokens.
API_AUTH_TOKEN=

# Origens liberadas para CORS, separadas por vírgula.
# VAZIO = sem CORS (o navegador só acessa a própria origem). Para o chat.html
# servido de outro host, aponte para a origem dele. Nunca use "*" com credenciais.
CORS_ORIGINS=

# --- Memória de sessão --------------------------------------------------------

SESSION_TTL_MINUTES=60      # Aging da conversa
SESSION_MAX=1000            # Teto de sessões simultâneas (evita crescimento sem fim)
SESSION_MAX_MENSAGENS=40    # Janela de contexto mantida por sessão
MAX_MENSAGEM_CARACTERES=4000

# --- Proteção de custo --------------------------------------------------------

RATE_LIMIT_REQUESTS=30      # Requisições por janela, por cliente
RATE_LIMIT_WINDOW_SEG=60

# --- Observabilidade e operação ------------------------------------------------

# Nível do log da API. A tela aqui é do técnico: INFO já mostra a troca de
# provedor, DEBUG traz o traceback.
LOG_LEVEL=INFO

# Nível do log de `python main.py`. Padrão WARNING de propósito: no CLI quem lê
# a tela é o cliente da Affiore, e o fallback entre provedores é rotina — ele não
# pode aparecer ali. Suba para DEBUG só ao diagnosticar.
# CLI_LOG_LEVEL=WARNING

# Diretório dos artefatos JSONL + auditoria.
# No container, aponte para /app/logs (o usuário 'affiore' precisa escrever).
# LOGS_DIR=./logs

# --- Modo de contingência ------------------------------------------------------

# Desliga o LLM: cada sessão recebe UMA mensagem padrão, depois silêncio.
# Pensado para indisponibilidade de provedor — a sessão não infla o custo.
# DISABLE_LLM=false
# STATIC_RESPONSE_MESSAGE=Olá! Nosso atendimento automático está temporariamente indisponível.